{
  "name": "Backend-loteria-avefenix",
  "version": "1.0.0",
  "description": "Backend para el registro de pagos de la loteria avefenix",
  "keywords": [],
  "license": "ISC",
  "author": "Gabriel Bermudez",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint",
    "dev": "tsx --env-file=.env --watch ./src/index.ts",
    "db:create": "tsx --env-file=.env ./src/db/schemas.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env ./dist/src/index.js",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
